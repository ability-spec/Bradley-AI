# Скопируй в .env и вставь ключи если хочешь гибрид 95% как Bradley
# Если оставишь пустым — будет чисто локально 70-80% силы

# Для гибрида — сила как у меня (Opus 5.5 / GPT-5)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Какую модель использовать как гибридный мозг
# Варианты:
# ollama/qwen2.5:14b-instruct-q4_K_M — локально, 8GB VRAM, 70% силы
# ollama/qwen2.5:32b-instruct-q4_K_M — локально с оффлоадом на RAM, 80% силы, ~8 ток/сек
# anthropic/claude-opus-4-5-20251101 — через API, 95% силы как я, платно
# openai/gpt-5 — через API, 90% силы
LLM_MODEL_HYBRID=ollama/qwen2.5:14b-instruct-q4_K_M

# Для Open WebUI
WEBUI_SECRET_KEY=jarvis-bradley-secret-key
